# Copy to .env on the server and fill in real values.

# Domain (DNS A-record must point to this server). Caddy issues HTTPS for it.
DOMAIN=market.bizdaoson.uz

# Postgres
POSTGRES_USER=adminmarket
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=adminmarket

# JWT — generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_key

# SMS: keep "console" until Eskiz credentials are ready (Phase 5), then set "eskiz".
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
