# Caddy serves the Flutter web build and reverse-proxies the API.
# Automatic HTTPS via Let's Encrypt (needs ports 80/443 open and DNS pointing here).
#
# The domain is read from the DOMAIN env var (set in .env). For local testing
# you can set DOMAIN=localhost (Caddy issues a self-signed cert).

{$DOMAIN} {
	encode gzip zstd

	# API, media uploads, and API docs go to the FastAPI service.
	@backend path /api/* /media/* /docs /openapi.json /health
	handle @backend {
		reverse_proxy api:8000
	}

	# Web Push service worker: serve as a real static file with NO SPA fallback,
	# so a missing/renamed file returns 404 instead of index.html (an HTML body
	# under a .js URL is what a CDN caches and then breaks SW registration).
	# no-store keeps Cloudflare from caching the worker at all.
	@psw path /psw/*
	handle @psw {
		root * /srv/web
		header Cache-Control "no-store"
		file_server
	}

	# App shell (mutable, NOT content-hashed by Flutter). Force revalidation so a
	# new build is picked up immediately instead of a CDN serving a stale bundle
	# (a stale main.dart.js with the wrong API base = "Cannot reach server").
	@appshell path / /index.html /flutter_bootstrap.js /flutter_service_worker.js /main.dart.js /flutter.js /manifest.json /version.json
	handle @appshell {
		root * /srv/web
		header Cache-Control "no-cache"
		file_server
	}

	# Everything else is the Flutter web SPA (client-side routing fallback).
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
