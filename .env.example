# ---- Database ----
POSTGRES_USER=adminmarket
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=adminmarket
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full URL overrides the parts above if set (used by docker-compose service networking).
# DATABASE_URL=postgresql+psycopg://adminmarket:change-me-in-prod@postgres:5432/adminmarket

# ---- JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- App ----
ENV=development
API_V1_PREFIX=/api/v1
# Comma-separated origins for CORS (Flutter web dev server, etc.)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---- SMS provider ----
# console = mock provider that prints OTP to logs (no credentials needed, dev default)
# eskiz   = real Eskiz.uz gateway (Phase 5)
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# ---- Storage provider ----
# local = save uploads to disk under MEDIA_ROOT (dev default)
# s3    = S3-compatible object storage (v2)
STORAGE_PROVIDER=local
MEDIA_ROOT=media
MEDIA_URL=/media
